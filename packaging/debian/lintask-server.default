# Settings for the Lintask server (systemd service "lintask-server").
# Enable and start:      sudo systemctl enable --now lintask-server
# After changes here:    sudo systemctl restart lintask-server
#
# Available options (all optional):
#   --port and the others below go into LINTASK_SERVER_OPTS.
#   LINTASK_SERVER_TOKEN is a variable of its own: a fixed access token that the desktop
#                       app enters when connecting. Unlike --token it does not show up in
#                       the process list. Without a token a new one is generated at every
#                       start and written to the journal:  journalctl -u lintask-server
#   --port 8765         port (default 8765)
#   --host 0.0.0.0      address to listen on (default: all)
#   --no-auth           no access token - only on trusted networks!
#
# Example:
#LINTASK_SERVER_TOKEN=PLEASE-CHANGE
#LINTASK_SERVER_OPTS="--port 8765"
LINTASK_SERVER_OPTS=""
